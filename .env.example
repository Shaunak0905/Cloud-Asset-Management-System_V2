# Copy this file to .env.local and fill in values from your Supabase project
# (Dashboard -> Project Settings -> API). Never commit .env.local.

# Public, browser-safe values (protected by RLS, not secret).
NEXT_PUBLIC_SUPABASE_URL=
# The project's "anon" key (or the newer "publishable" key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used to build QR / public asset URLs.
# Local: http://localhost:3000  Production: https://<production-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Leave unset unless a documented feature requires it.
# NEVER prefix with NEXT_PUBLIC_ and never import it from client code.
# SUPABASE_SERVICE_ROLE_KEY=
